@@ -46,15 +46,20 @@ see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
 /* This avoids lossage on SunOS but only if stdtypes.h comes first.
    There's no way to win with the other order!  Sun lossage.  */
 
-#if defined(__NetBSD__)
+/* MINIX 3 carries NetBSD's headers and therefore NetBSD's _BSD_*_T_
+   convention in <machine/ansi.h>; it is not there while libgcc is built
+   ahead of the libc.  */
+#if defined(__NetBSD__) || defined(__minix)
