# Output of the stand-alone aarch64 bring-up build. Nested .gitignore files
# are ignored themselves (see above), so this has to live here.
minix/kernel/arch/aarch64/bringup/kernel.elf

# The message payload tools import a shared module, so python leaves a
# bytecode cache beside them.
minix/kernel/arch/aarch64/tools/__pycache__/

# Your own installation: the address of the board, the console machine and
# the ssh key are different for everybody.  port/board.conf.example is the
# template.
port/board.conf

# A public key belongs to a person, not to an operating system.  mkroot.sh
# puts this one into the eMMC image if it is there.
port/authorized_keys

# Reference sources kept beside the GMAC driver: they are Linux, under the
# GPL, and this tree is BSD.  port/cb2-gmac/ref/README.md says where to get
# them and what was taken from them (register numbers, not text).
port/cb2-gmac/ref/*.c
port/cb2-gmac/ref/*.h
port/cb2-gmac/ref/*.dts

# The same beside the USB driver, and for the same reason: Linux sources of
# the exact version the board runs, kept for register numbers only.
# port/cb2-usb/ref/README.md says where they come from.
port/cb2-usb/ref/*.c
port/cb2-usb/ref/*.h
port/cb2-usb/ref/*.dts
port/cb2-usb/ref/*.dtsi

# Scratch space and run logs that nothing cites.
port/scratch/

# ...but the toolchain patches are not "some patch somebody left lying
# around", which is what the *.patch rule above is for.  They are the
# difference between a stock GCC/binutils and one that knows the target
# aarch64-elf64-minix, port/build-xtools.sh cannot run without them, and
# without it there is no userland.  They were silently left out of the first
# published commit for exactly this reason.
!port/toolchain/*.patch

# Byte-compiled Python.  The stands under port/test are run as scripts, so
# these are pure build products - and one of them was committed once.
__pycache__/
*.pyc
