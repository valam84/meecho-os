# Своя установка для скриптов работы с платой. Скопировать в board.conf
# (он не отслеживается git) и поправить под себя.
#
# В прогоне участвуют две машины, и это не усложнение, а расстановка:
#
#   BOARD  сама плата. На ней живёт вендорский Linux, через который
#          ставится сборка и взводится флаг одноразовой загрузки MEECHO.
#          Когда MEECHO загрузилась, этот адрес ведёт уже в неё.
#
#   HUB    машина, в которую воткнут USB-TTL платы. Консоль читается
#          оттуда, и читается ДО перезагрузки платы - иначе начало
#          загрузки в журнал не попадёт, а там печатается всё интересное.
#
# Обе могут оказаться одной машиной; тогда просто задайте одинаковые
# адреса. Раздельными они сделаны потому, что консоль и система на плате
# отваливаются в разные моменты и по разным причинам.

# Плата: имя из ~/.ssh/config или root@адрес.
BOARD=cb2
BOARD_PORT=22

# Консольная машина с USB-TTL.
HUB=root@hub
HUB_PORT=22

# Ключ ssh, которым ходим на обе.
KEY=$HOME/.ssh/id_ed25519

# Последовательный порт платы на консольной машине и скорость.
# 1500000 - штатная для uart2 CB2; на ней через дешёвый переходник
# знаки теряются молча, поэтому прогон, который придётся цитировать,
# стоит гонять на 115200 (флаг /boot/meecho/slow_console).
TTY=/dev/ttyUSB0
BAUD=1500000

# Предел ожидания одного прогона, секунды.
WAIT_MAX=1800
