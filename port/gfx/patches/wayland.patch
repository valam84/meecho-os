diff --git a/src/wayland-os.c b/src/wayland-os.c
index f00ead4..b339380 100644
--- a/src/wayland-os.c
+++ b/src/wayland-os.c
@@ -106,6 +106,25 @@ wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
 #endif
 	return 0;
 }
+#elif defined(LOCAL_PEEREID)
+/*
+ * MEECHO (__minix), as NetBSD: the peer's identity, recorded by the
+ * socket at connect(2) - what getpeereid(3) reads, plus the pid.
+ */
+int
+wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
+{
+	socklen_t len;
+	struct unpcbid ucred;
+
+	len = sizeof(ucred);
+	if (getsockopt(sockfd, 0, LOCAL_PEEREID, &ucred, &len) < 0)
+		return -1;
+	*uid = ucred.unp_euid;
+	*gid = ucred.unp_egid;
+	*pid = ucred.unp_pid;
+	return 0;
+}
 #elif defined(SO_PEERCRED)
 int
 wl_os_socket_peercred(int sockfd, uid_t *uid, gid_t *gid, pid_t *pid)
diff --git a/src/wayland-shm.c b/src/wayland-shm.c
index 3ac4add..a4181e7 100644
--- a/src/wayland-shm.c
+++ b/src/wayland-shm.c
@@ -376,7 +376,17 @@ shm_create_pool(struct wl_client *client, struct wl_resource *resource,
 		goto err_close;
 	}
 
-#ifdef HAVE_MEMFD_CREATE
+#if defined(__minix)
+	/*
+	 * MEECHO: a pool is a memory object (memfd_create(2)) - nothing else
+	 * maps shared and writable here - and a memory object never raises
+	 * SIGBUS: past its end VM gives a zeroed page too.  Nor is there
+	 * SA_SIGINFO to tell the address of one that came.
+	 */
+	(void)seals;
+	(void)statbuf;
+	pool->sigbus_is_impossible = true;
+#elif defined(HAVE_MEMFD_CREATE)
 	seals = fcntl(fd, F_GET_SEALS);
 	if (seals == -1)
 		seals = 0;
@@ -679,7 +689,12 @@ init_sigbus_data_key(void)
 {
 	struct sigaction new_action = {
 		.sa_sigaction = sigbus_handler,
+#ifdef SA_SIGINFO
 		.sa_flags = SA_SIGINFO | SA_NODEFER
+#else
+		/* MEECHO: never installed; see sigbus_is_impossible. */
+		.sa_flags = SA_NODEFER
+#endif
 	};
 
 	sigemptyset(&new_action.sa_mask);
