	sound {
		compatible = "qcom,sdm660-internal-sndcard";
		model = "Xiaomi Mi Pad 4";
		pinctrl-0 = <0x96 0x97>;
		pinctrl-names = "default";
		audio-routing = "RX_BIAS", "Digital MCLK", "INT_LDO_H", "Digital MCLK", "Digital RX_I2S_CLK", "Digital MCLK", "Digital TX_I2S_CLK", "Digital MCLK", "Digital ADC1", "ADC1", "Digital ADC2", "ADC2", "Digital ADC3", "ADC3", "PDM_RX1", "Digital PDM_RX1", "PDM_RX2", "Digital PDM_RX2", "PDM_RX3", "Digital PDM_RX3", "Digital LPASS_PDM_TX", "PDM_TX", "AMIC1", "MIC BIAS External1", "AMIC2", "MIC BIAS External2";

		mm1-dai-link {
			link-name = "MultiMedia1";

			cpu {
				sound-dai = <0x98 0x00>;
			};
		};

		mm2-dai-link {
			link-name = "MultiMedia2";

			cpu {
				sound-dai = <0x98 0x01>;
			};
		};

		int0-mi2s-dai-link {
			link-name = "Internal MI2S Playback";

			cpu {
				sound-dai = <0x99 0x89>;
			};

			platform {
				sound-dai = <0x9a>;
			};

			codec {
				sound-dai = <0x9b 0x00 0x9c 0x00>;
			};
		};

		int3-mi2s-dai-link {
			link-name = "Internal MI2S Capture";

			cpu {
				sound-dai = <0x99 0x90>;
			};

			platform {
				sound-dai = <0x9a>;
			};

			codec {
				sound-dai = <0x9b 0x01 0x9c 0x01>;
			};
		};
	};

	thermal-zones {

		aoss-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x9d 0x00>;

			trips {

				trip-point0 {
					temperature = <0x19a28>;
					hysteresis = <0x3e8>;
					type = "hot";
				};
			};
		};

		cpuss0-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x9d 0x01>;

			trips {

				trip-point0 {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "hot";
				};
			};
		};

		cpuss1-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x9d 0x02>;

			trips {

				trip-point0 {
					temperature = <0x1e848>;
					hysteresis = <0x3e8>;
					type = "hot";
				};
			};
		};

		cpu0-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x9d 0x03>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		cpu1-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x9d 0x04>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		cpu2-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x9d 0x05>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		cpu3-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x9d 0x06>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		pwr-cluster-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x9d 0x07>;

			trips {

				trip-point0 {
					temperature = <0x11170>;
					hysteresis = <0x3e8>;
					type = "passive";
				};

				cpu-crit {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		gpu-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0x9d 0x08>;

			cooling-maps {

				map0 {
					trip = <0x9e>;
					cooling-device = <0x9f 0xffffffff 0xffffffff>;
				};
			};

			trips {

				trip-point0 {
					temperature = <0x14c08>;
					hysteresis = <0x3e8>;
					type = "passive";
					phandle = <0x9e>;
				};

				trip-point1 {
					temperature = <0x15f90>;
					hysteresis = <0x3e8>;
					type = "hot";
				};

				trip-point2 {
					temperature = <0x1adb0>;
					hysteresis = <0x3e8>;
					type = "critical";
				};
			};
		};

		pm660-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa0>;

			trips {

				pm660-alert0 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				pm660-crit {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};

		pm660l-thermal {
			polling-delay-passive = <0xfa>;
			thermal-sensors = <0xa1>;

			trips {

				pm660l-alert0 {
					temperature = <0x17318>;
					hysteresis = <0x7d0>;
					type = "passive";
				};

				pm660l-crit {
					temperature = <0x1e848>;
					hysteresis = <0x7d0>;
					type = "critical";
				};
			};
		};
	};

	timer {
		compatible = "arm,armv8-timer";
		interrupts = <0x01 0x01 0xf08 0x01 0x02 0xf08 0x01 0x03 0xf08 0x01 0x00 0xf08>;
	};

	smp2p-cdsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x5e 0x1b0>;
		interrupts = <0x00 0x202 0x01>;
		mboxes = <0x1c 0x1e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x05>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x94>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x92>;
		};
	};

	lcd-power-regulator {
		compatible = "regulator-fixed";
		regulator-name = "lcd_pwr";
		regulator-min-microvolt = <0x325aa0>;
		regulator-max-microvolt = <0x325aa0>;
		gpio = <0x3b 0x05 0x00>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <0xa2>;
		phandle = <0x5e>;
	};

	vph-pwr-regulator {
		compatible = "regulator-fixed";
		regulator-name = "vph_pwr";
		regulator-always-on;
		regulator-boot-on;
		phandle = <0x1e>;
	};

	gpio-keys {
		compatible = "gpio-keys";
		pinctrl-0 = <0xa3>;
		pinctrl-names = "default";

		key-volup {
			label = "Volume Up";
			gpios = <0x3b 0x07 0x01>;
			linux,code = <0x73>;
			debounce-interval = <0x0f>;
		};
	};

	gpio-hall-sensor {
		compatible = "gpio-keys";
		pinctrl-0 = <0xa4>;
		pinctrl-names = "default";

		switch {
			label = "Hall Effect Sensor";
			gpios = <0x29 0x4b 0x01>;
			linux,input-type = <0x05>;
			linux,code = <0x00>;
			linux,can-disable;
			wakeup-source;
		};
	};

	battery {
		compatible = "simple-battery";
		device-chemistry = "lithium-ion";
		charge-full-design-microamp-hours = <0x5bb490>;
		voltage-min-design-microvolt = <0x33e140>;
		voltage-max-design-microvolt = <0x432380>;
		phandle = <0x37>;
	};
};
