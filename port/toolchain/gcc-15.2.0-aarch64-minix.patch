 #endif
 
-#if defined(__NetBSD__)
+#if (defined(__NetBSD__) || defined(__minix)) && !defined(inhibit_libc)
 #if !defined(_SIZE_T_) && !defined(_BSD_SIZE_T_)
 #define _SIZE_T
 #endif
@@ -81,7 +86,7 @@ see the files COPYING3 and COPYING.RUNTIME respectively.  If not, see
 #undef _WCHAR_T_
 #undef _BSD_WCHAR_T_
 #endif
-#endif /* defined(__NetBSD__) */
+#endif /* BSD headers available */
 
 /* Sequent's header files use _PTRDIFF_T_ in some conflicting way.
    Just ignore it.  */
