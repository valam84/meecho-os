#!/bin/sh
set -e

PATH=/sbin:/usr/sbin:/bin:/usr/bin

FSCK=/bin/fsck_mfs
ACPI=/service/acpi

if [ X`sysenv arch` = Xi386 ]
then	if [ -e $ACPI -a -n "`sysenv acpi`" ]
	then
		minix-service -c up $ACPI
	fi
	minix-service -c up /service/pci -dev /dev/pci

	minix-service -c up /service/input -dev /dev/kbdmux
	minix-service -c up /service/pckbd || :

	# Start procfs so we can access /proc/pci
	mount -t procfs none /proc >/dev/null

	# Do we want to use the virtio block device?
	# If not specified, default to yes if the device is found.
	if sysenv virtio_blk >/dev/null
	then	virtio_blk="`sysenv virtio_blk`"
        elif	grep '^[^ ]* [^ ]* 1AF4:1001[^ ]* ' /proc/pci >/dev/null
	then	echo "virtio_blk not set, defaulting to using found virtio device."
		virtio_blk=yes
        fi

	minix-service -cn up /service/floppy -dev /dev/fd0
	if [ X`sysenv ahci` = Xyes ]
	then
		# this is here temporarily, for testing purposes
		minix-service -c up /service/ahci -dev /dev/c0d0 -label ahci_0 -args instance=0
	elif [ X"$virtio_blk" = Xyes ]
	then
		minix-service -c up /service/virtio_blk -dev /dev/c0d0 -label virtio_blk_0 -args instance=0
	else
		minix-service -c up /service/at_wini -dev /dev/c0d0 -label at_wini_0
		minix-service -cr up /service/at_wini -dev /dev/c1d0 -label at_wini_1 -args instance=1 2>/dev/null || :
	fi
	umount /proc >/dev/null
fi

if [ X`sysenv arch` = Xearm ]
then	echo Starting the mmc driver
	minix-service -c up /service/mmc -dev /dev/c0d0
fi

if [ X`sysenv arch` = Xaarch64 ]
then
	# The real-time clock, whatever the device tree says it is.  On a
	# machine without one the driver stays up and answers "no clock",
	# readclock fails quietly, and the date is set to a fixed one: a
	# wrong date is better than the epoch, which init has already once
	# read as "never".  -c for the same reason as the disk driver below.
	minix-service -c up /service/readclock.drv
	readclock -q || date 201301010000

	# The disk driver, which finds its own device in the device tree but
	# cannot be guessed at from here: QEMU's virt has a virtio disk and
	# the CB2 has an eMMC behind an SD host controller, and the driver
	# that does not find its node fails loudly.  So the boot script says
	# which one this machine has, the same way it says which console;
	# without a word, it is virtio, which is what the emulator has.
	#
	# Started only when the root is going to be on it: with bootramdisk=1
	# this image is the root and no disk is needed.  -c keeps a copy of
	# the binary inside RS, because this image is unmounted from under it
	# once the disk is the root.
	if ! sysenv bootramdisk >/dev/null
	then
		if sysenv blkdrv >/dev/null
		then	blkdrv="`sysenv blkdrv`"
		else	blkdrv=virtio_blk
		fi

		case "$blkdrv" in
		sdmmc)
			echo Starting the SD/MMC block driver
			minix-service -c up /service/sdmmc -dev /dev/c0d0 \
				-label sdmmc_0 -args instance=0
			# And the machine's second storage controller, if it
			# has one: soldered devices are numbered first, so on
			# the CB2 this is the SD socket behind the eMMC, and on
			# a board with only a socket it is nothing.  No
			# controller, an empty socket, a card that will not
			# answer - the driver says which and leaves, and the
			# boot goes on; the root is whichever rootdevname
			# names, c0d0 or c1d0.
			minix-service -c up /service/sdmmc -dev /dev/c1d0 \
				-label sdmmc_1 -args instance=1 2>/dev/null || :
			;;
		*)
			echo Starting the virtio block driver
			minix-service -c up /service/virtio_blk -dev /dev/c0d0 \
				-label virtio_blk_0 -args instance=0
			;;
		esac
	fi
fi

# Load ProcFS from the ramdisk to minimize the chance of a desync with the boot
# image services from which it obtains data structures directly.  As we move to
# the MIB service, this will eventually become obsolete.
minix-service up /service/procfs || echo "WARNING: couldn't start procfs"

if sysenv rootdevname >/dev/null
then	rootdevname=/dev/`sysenv rootdevname`
else
	if ! sysenv cdproberoot >/dev/null && ! sysenv bootramdisk >/dev/null
	then	echo "rootdevname not set"
		exit 1
	fi
fi

if [ "`sysenv bin_img`" = 1 ]
then
    bin_img="-c "
fi

if sysenv cdproberoot >/dev/null
then
	echo
	echo 'Looking for boot CD. This may take a minute.'
	echo 'Please ignore any error messages.'
	echo
	rootdevname=$(cdprobe) || { echo 'No CD found'; exit 1; }
	export rootdevname
elif [ "$rootdevname" = "/dev/ram" ]
then
	ramimagename=/dev/`sysenv ramimagename`
	echo "Loading ramdisk from $ramimagename"
	loadramdisk "$ramimagename" || echo "WARNING: loadramdisk failed"
fi

if sysenv bootramdisk >/dev/null
then
	rootdevname=imgrd
fi

echo "Root device name is $rootdevname"

# With bootramdisk the root is the image the kernel was handed, VFS has
# mounted it already, and the mount below is skipped for the same reason.
# There is nothing to check and no unmounted device to check it on -
# $rootdevname is the bare name "imgrd", not a path fsck could open - so the
# check goes the way of the mount.
if ! sysenv cdproberoot >/dev/null && ! sysenv bootramdisk >/dev/null
then
	if [ -e $FSCK ]
	then
		# Exit code 16 means fsck does not know this file system's
		# format, which is not the same as finding it broken: a V4
		# root has no fsck yet (stage 7.5).  It is mounted with a
		# warning; every other failure stops the boot, as before.
		$FSCK -p $rootdevname && fsck_rc=0 || fsck_rc=$?
		if [ $fsck_rc != 0 ]
		then
			if [ $fsck_rc = 16 ]
			then	echo "WARNING: $rootdevname was not checked"
			else	exit 1
			fi
		fi
	fi
fi

# Change root from temporary boot ramdisk to the configure root device
#
# The root file system server is started here, not by mount(8), for one
# flag: -f, never restart.  A restart of the root cannot work.  RS would
# read the binary back through VFS from the very file system that died and
# wait for it forever (the machine just stops answering); with an in-memory
# copy (bin_img=1) it gets further, but the new instance has to take over
# the state of the one that crashed, fails to, and the mount is gone all the
# same - VFS cannot put a new server under every process's open files.
# Without a restart the dead server is cleaned up at once, and VFS, seeing
# the root file system exit, says so and stops the machine.  Measured with
# port/test/audit/rootfs-crash.py.  The label is the one mount(8) would
# make; rslabel= is how mount -e finds the server while the type stays mfs.
if ! sysenv bootramdisk >/dev/null; then
	rootlabel=fs_`printf %.12s "${rootdevname##*/}"`
	minix-service $bin_img-f up /service/mfs -label "$rootlabel" \
		-args "$rootdevname /"
	mount -e -n -t mfs -o rslabel="$rootlabel" "$rootdevname" /

	# Reopen standard file descriptors, so that we can unmount the ramdisk.
	# That is essentially a VFS shortcoming that should be fixed, though..
	exec >/dev/log
	exec 2>/dev/log
	exec </dev/console
fi

# Give RS the binary of the one boot-image service that can be restarted.
# RS started the boot image from the boot archive and has no path to any of
# it, so a crash of a boot service ends in "read_exec failed" and RS
# stopping the machine.  etc/rc.minix edits all of them; here only mib,
# because only mib restarts without state (its restart callback is a fresh
# init).  tty, memory, pfs, ds, sched, vfs and pm restart statefully, and a
# state transfer from an instance that crashed is refused by libsys unless
# the crash was injected - with a path they die the same way, one step
# later.  Measured with port/test/audit/boot-restart.py.  On a ramdisk root
# there is no /service/mib, and nothing to do.
if [ X`sysenv arch` = Xaarch64 -a -x /service/mib ]
then
	minix-service edit /service/mib -label mib || :
fi

# Mount the ProcFS instance that was loaded from the ramdisk, on the root FS.
mount -e -n -t procfs none /proc || echo "WARNING: couldn't mount procfs"

# Start the NetBSD rc infrastructure
if ! sysenv bootramdisk >/dev/null; then
	exec sh /etc/rc "$@"
fi
