#
# Stand-alone build for the AArch64 kernel during bring-up.
#
#	make -f Makefile.bringup		build kernel.elf
#	make -f Makefile.bringup run		boot it under QEMU
#	make -f Makefile.bringup run-el2	same, entered at EL2 as U-Boot does
#	make -f Makefile.bringup debug		wait for gdb before the first insn
#	make -f Makefile.bringup debug-el2	same, entered at EL2
#	make -f Makefile.bringup gdb		attach to a waiting instance
#
# This is scaffolding, not the final build. The kernel eventually belongs to
# the NetBSD build system like every other part of the tree, but that
# toolchain is binutils 2.23.2 and GCC 4.8.5 and has no aarch64-minix target.
# Teaching it one is weeks of work on code from 2013, and none of it is
# needed to write the arch layer: the kernel is freestanding, so an
# off-the-shelf cross compiler does the job and gives modern diagnostics
# while we write new code.
#
# The toolchain question comes back when userland matters, which is stages
# away. See PLAN.md.
#

CROSS?=		aarch64-linux-gnu-
CC=		$(CROSS)gcc
LD=		$(CROSS)ld
OBJCOPY=	$(CROSS)objcopy
OBJDUMP=	$(CROSS)objdump

# Cortex-A72 is what the Compute Module 4 has. QEMU virt is told to emulate
# the same core, so code generation matches the eventual target.
CPU?=		cortex-a72

# -nostdinc drops every default include path, so that a stray #include can
# never reach the host's glibc headers. The compiler's own freestanding
# headers - stdint.h, stddef.h, stdarg.h, stdbool.h - live in its private
# include directory and still have to be reachable, so add just that one back.
GCC_INCLUDE:=	$(shell $(CC) -print-file-name=include)

# Distance between a physical address and the kernel-virtual address of the
# same byte. The kernel is linked at KERNEL_PHYS_BASE + this and loaded at
# KERNEL_PHYS_BASE; see mmu.h for the address space layout and kernel.lds for
# how the two addresses are kept apart.
#
# It is defined here, once, and handed to both the compiler and the linker.
# Splitting it between a header and the link script would let the two drift,
# and the symptom would be a machine that dies with the MMU half on.
KERNEL_VA_OFFSET?= 0xffff000000000000

# -ffreestanding      there is no libc and no hosted environment
# -mgeneral-regs-only the kernel must not touch FP/SIMD registers: they are
#                     not saved on entry, and using them would corrupt user
#                     state and trap while FP is disabled
# -fno-stack-protector the guard variable lives in libc
# -fno-pic            the kernel runs at its link address
# -mcmodel=small      the default, but named explicitly because early boot
#                     depends on it: it reaches symbols with PC-relative
#                     adrp/add, which is what lets the image execute at its
#                     physical address before the MMU is on. See mmu.c.
# -fno-tree-loop-distribute-patterns
#                     stops GCC turning a clearing loop into a call to memset,
#                     which does not exist here
CFLAGS=		-Wall -Wextra -Werror -O2 -g \
		-mcpu=$(CPU) \
		-ffreestanding -nostdinc -fno-builtin \
		-isystem $(GCC_INCLUDE) \
		-mgeneral-regs-only \
		-fno-stack-protector -fno-pic -fno-pie \
		-mcmodel=small \
		-fno-tree-loop-distribute-patterns \
		-fno-common \
		-DKERNEL_VA_OFFSET=$(KERNEL_VA_OFFSET)UL \
		-Ibsp/include

ASFLAGS=	-mcpu=$(CPU) -g

LDFLAGS=	-nostdlib -static -no-pie -T kernel.lds \
		--defsym=KERNEL_VA_OFFSET=$(KERNEL_VA_OFFSET)

OBJS=		head.o start.o kprint.o mmu.o bsp/qemu-virt/virt_serial.o

KERNEL=		kernel.elf

# QEMU's virt machine, one Cortex-A72, no graphics, serial on stdio.
#
# -net none matters: without it QEMU adds a default NIC and fails looking for
# efi-virtio.rom, which is in a package we have no other reason to install.
QEMU=		qemu-system-aarch64
QEMUFLAGS=	-M virt -cpu $(CPU) -m 512 -display none -serial mon:stdio \
		-net none -kernel $(KERNEL)

# On the real board U-Boot hands control over at EL2, so the drop to EL1 in
# head.S has to work. Plain "virt" enters at EL1 and never exercises that
# path; virtualization=on does. Test both.
QEMUFLAGS_EL2=	-M virt,virtualization=on -cpu $(CPU) -m 512 -display none \
		-serial mon:stdio -net none -kernel $(KERNEL)

all: $(KERNEL)

$(KERNEL): $(OBJS) kernel.lds
	$(LD) $(LDFLAGS) -o $@ $(OBJS)
	@echo
	@$(OBJDUMP) -h $@ | head -12

%.o: %.S
	$(CC) $(ASFLAGS) -c -o $@ $<

%.o: %.c
	$(CC) $(CFLAGS) -c -o $@ $<

run: $(KERNEL)
	@echo "--- Ctrl-A x to quit ---"
	$(QEMU) $(QEMUFLAGS)

# Same, but entered at EL2 the way real firmware does it.
run-el2: $(KERNEL)
	@echo "--- Ctrl-A x to quit ---"
	$(QEMU) $(QEMUFLAGS_EL2)

# Halt before the first instruction and wait for gdb on port 1234.
debug: $(KERNEL)
	$(QEMU) $(QEMUFLAGS) -S -s

debug-el2: $(KERNEL)
	$(QEMU) $(QEMUFLAGS_EL2) -S -s

# The kernel exists at two addresses, so gdb is given two symbol tables: the
# link addresses in the upper half, and the same symbols shifted down to the
# physical addresses the kernel actually runs at until the MMU is on. Without
# the second one, single-stepping through early boot - which is the whole
# reason this target exists - shows no symbols and no source at all.
gdb:
	gdb-multiarch \
		-ex 'set confirm off' \
		-ex 'target remote :1234' \
		-ex 'symbol-file $(KERNEL)' \
		-ex 'add-symbol-file $(KERNEL) -o -$(KERNEL_VA_OFFSET)' \
		-ex 'set confirm on'

disasm: $(KERNEL)
	$(OBJDUMP) -d $(KERNEL)

clean:
	rm -f $(OBJS) $(KERNEL)

.PHONY: all run run-el2 debug debug-el2 gdb disasm clean
