<?xml version="1.0" encoding="UTF-8"?>
<!--
  MEECHO's wallpaper (/usr/share/meecho/wallpaper.svg), made from
  MEECHO's colours: minix/share/style - wbg draws it, scaled to the
  screen.  What it shows is the desktop's own idea: windows as columns on
  a strip that runs past both edges of the screen, the one in focus
  ringed in MEECHO blue, the workspaces above and below just showing -
  and in the focused column the mark, in the pixels of the console's
  font.  nanosvg (wbg's) draws no text, so the letters are squares on a
  five by seven grid.
-->
<svg xmlns="http://www.w3.org/2000/svg" width="1920" height="1080" viewBox="0 0 1920 1080">
  <defs>
    <linearGradient id="ground" x1="0" y1="0" x2="1920" y2="1080" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="#@ink@"/>
      <stop offset="1" stop-color="#@ink_deep@"/>
    </linearGradient>
  </defs>
  <rect width="1920" height="1080" fill="url(#ground)"/>
  <!-- the workspace above -->
  <g opacity="0.3">
