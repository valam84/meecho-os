#	$NetBSD: Makefile,v 1.5 2015/09/03 22:24:02 youri Exp $

.include <bsd.own.mk>

SUBDIR+=	expat lua

#
# The Wayland stack of stage 11 (port/gfx/README), in the order its pieces
# need each other - a library is installed before its users are built.  It
# also needs minix/lib/libgfxcompat and libepoll-shim, and its protocol
# code is generated by nbwayland-scanner, which only the aarch64 tools
# build (tools/wayland-scanner).
#
.if ${MACHINE_ARCH} == "aarch64"
SUBDIR+=	.WAIT libffi wayland-protocols pixman libdrm libxkbcommon \
		xkeyboard-config tllist freetype libyaml
SUBDIR+=	.WAIT wayland fontconfig
SUBDIR+=	.WAIT wlroots fcft
SUBDIR+=	.WAIT foot fuzzel yambar
# Mesa (stage 11.6): needs libdrm and the toolchain's C++ second pass,
# ~/xtools-aarch64-cxx (port/build-xtools.sh cxx; external/mit/mesa).
SUBDIR+=	mesa
.endif

.if ${MKX11} != "no"
SUBDIR+=	xorg
SUBDIR+=	.WAIT ctwm
.endif

.include <bsd.subdir.mk>
