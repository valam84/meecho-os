/dts-v1/;

/ {
	interrupt-parent = <0x01>;
	#address-cells = <0x02>;
	#size-cells = <0x02>;
	model = "Xiaomi Mi Pad 4 LTE";
	compatible = "xiaomi,clover-lte", "qcom,sdm660";

	aliases {
		mmc1 = "/soc@0/mmc@c0c4000";
		mmc2 = "/soc@0/mmc@c084000";
		serial0 = "/soc@0/serial@c170000";
		serial1 = "/soc@0/serial@c1af000";
	};

	chosen {
		pureason = <0x00 0x80010>;
		linux,initrd-end = <0x00 0x83edd7f5>;
		linux,initrd-start = <0x00 0x83400000>;
		kaslr-seed = <0x00 0x00>;
		bootargs = "ignore_loglevel pmos_boot_uuid=98ecc23a-0614-4363-96cf-a99afc77ba68 pmos_root_uuid=408f1f31-18a8-40b9-8ee1-afe90d327c18 pmos_rootfsopts=defaults nocpuboost root=/dev/dm-0 dm=\"system none ro,0 1 android-verity /dev/mmcblk0p13\" androidboot.verifiedbootstate=orange androidboot.keymaster=1  androidboot.veritymode=enforcing androidboot.bootdevice=c0c4000.sdhci androidboot.serialno=<serial> androidboot.mode=charger androidboot.secureboot=1 androidboot.baseband=sdm mdss_mdp.panel=1:dsi:0:qcom,mdss_dsi_nt51021_boe_wuxga_video:config0:1:none:cfg:single_dsi";
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;
		stdout-path = "serial0:115200n8";

		framebuffer@9d400000 {
			compatible = "simple-framebuffer";
			reg = <0x00 0x9d400000 0x00 0x8ca000>;
			width = <0x4b0>;
			height = <0x780>;
			stride = <0x12c0>;
			format = "a8r8g8b8";
			assigned-clocks = <0x02 0x70 0x02 0x74>;
			assigned-clock-rates = <0x11e1a300 0x124f800>;
			clocks = <0x02 0x60 0x02 0x61 0x02 0x74 0x02 0x70 0x02 0x01 0x02 0x83 0x02 0x62 0x02 0x63 0x02 0x77 0x02 0x75 0x02 0x71 0x02 0x6d>;
			power-domains = <0x03 0x00 0x02 0x02>;
		};
	};

	clocks {

		int-cdc-bclk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x177000>;
			clock-output-names = "int_cdc_bclk";
			phandle = <0x8a>;
		};

		xo-board {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x124f800>;
			clock-output-names = "xo_board";
			phandle = <0x25>;
		};

		sleep-clk {
			compatible = "fixed-clock";
			#clock-cells = <0x00>;
			clock-frequency = <0x7ffc>;
			clock-output-names = "sleep_clk";
			phandle = <0x26>;
		};
	};

	cpus {
		#address-cells = <0x02>;
		#size-cells = <0x00>;

		cpu@100 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x100>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06 0x07 0x08>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x09>;
			phandle = <0x14>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x09>;
			};
		};

		cpu@101 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x101>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06 0x07 0x08>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x09>;
			phandle = <0x15>;
		};

		cpu@102 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x102>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06 0x07 0x08>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x09>;
			phandle = <0x16>;
		};

		cpu@103 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x103>;
			enable-method = "psci";
			cpu-idle-states = <0x04 0x05 0x06 0x07 0x08>;
			capacity-dmips-mhz = <0x400>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x09>;
			phandle = <0x17>;
		};

		cpu@0 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x00>;
			enable-method = "psci";
			cpu-idle-states = <0x0a 0x0b 0x0c 0x0d 0x0e>;
			capacity-dmips-mhz = <0x280>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x0f>;
			phandle = <0x10>;

			l2-cache {
				compatible = "cache";
				cache-level = <0x02>;
				cache-unified;
				phandle = <0x0f>;
			};
		};

		cpu@1 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x01>;
			enable-method = "psci";
			cpu-idle-states = <0x0a 0x0b 0x0c 0x0d 0x0e>;
			capacity-dmips-mhz = <0x280>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x0f>;
			phandle = <0x11>;
		};

		cpu@2 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x02>;
			enable-method = "psci";
			cpu-idle-states = <0x0a 0x0b 0x0c 0x0d 0x0e>;
			capacity-dmips-mhz = <0x280>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x0f>;
			phandle = <0x12>;
		};

		cpu@3 {
			device_type = "cpu";
			compatible = "qcom,kryo260";
			reg = <0x00 0x03>;
			enable-method = "psci";
			cpu-idle-states = <0x0a 0x0b 0x0c 0x0d 0x0e>;
			capacity-dmips-mhz = <0x280>;
			#cooling-cells = <0x02>;
			next-level-cache = <0x0f>;
			phandle = <0x13>;
		};

		cpu-map {

			cluster0 {

				core0 {
					cpu = <0x10>;
				};

				core1 {
					cpu = <0x11>;
				};

				core2 {
					cpu = <0x12>;
				};

				core3 {
					cpu = <0x13>;
				};
			};

			cluster1 {

				core0 {
					cpu = <0x14>;
				};

				core1 {
					cpu = <0x15>;
				};

				core2 {
					cpu = <0x16>;
				};

				core3 {
					cpu = <0x17>;
				};
			};
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "pwr-retention";
				arm,psci-suspend-param = <0x40000002>;
				entry-latency-us = <0x152>;
				exit-latency-us = <0x1a7>;
				min-residency-us = <0xc8>;
				phandle = <0x0a>;
			};

			cpu-sleep-0-1 {
				compatible = "arm,idle-state";
				idle-state-name = "pwr-power-collapse";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x203>;
				exit-latency-us = <0x71d>;
				min-residency-us = <0x3e8>;
				local-timer-stop;
				phandle = <0x0b>;
			};

			cpu-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "perf-retention";
				arm,psci-suspend-param = <0x40000002>;
				entry-latency-us = <0x9a>;
				exit-latency-us = <0x57>;
				min-residency-us = <0xc8>;
				phandle = <0x04>;
			};

			cpu-sleep-1-1 {
				compatible = "arm,idle-state";
				idle-state-name = "perf-power-collapse";
				arm,psci-suspend-param = <0x40000003>;
				entry-latency-us = <0x106>;
				exit-latency-us = <0x12d>;
				min-residency-us = <0x3e8>;
				local-timer-stop;
				phandle = <0x05>;
			};

			cluster-sleep-0-0 {
				compatible = "arm,idle-state";
				idle-state-name = "pwr-cluster-dynamic-retention";
				arm,psci-suspend-param = <0x400000f2>;
				entry-latency-us = <0x11c>;
				exit-latency-us = <0x180>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x0c>;
			};

			cluster-sleep-0-1 {
				compatible = "arm,idle-state";
				idle-state-name = "pwr-cluster-retention";
				arm,psci-suspend-param = <0x400000f3>;
				entry-latency-us = <0x152>;
				exit-latency-us = <0x1a7>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x0d>;
			};

			cluster-sleep-0-2 {
				compatible = "arm,idle-state";
				idle-state-name = "pwr-cluster-retention";
				arm,psci-suspend-param = <0x400000f4>;
				entry-latency-us = <0x203>;
				exit-latency-us = <0x71d>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x0e>;
			};

			cluster-sleep-1-0 {
				compatible = "arm,idle-state";
				idle-state-name = "perf-cluster-dynamic-retention";
				arm,psci-suspend-param = <0x400000f2>;
				entry-latency-us = <0x110>;
				exit-latency-us = <0x149>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x06>;
			};

			cluster-sleep-1-1 {
				compatible = "arm,idle-state";
				idle-state-name = "perf-cluster-retention";
				arm,psci-suspend-param = <0x400000f3>;
				entry-latency-us = <0x14c>;
				exit-latency-us = <0x170>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x07>;
			};

			cluster-sleep-1-2 {
				compatible = "arm,idle-state";
				idle-state-name = "perf-cluster-retention";
				arm,psci-suspend-param = <0x400000f4>;
				entry-latency-us = <0x221>;
				exit-latency-us = <0x649>;
				min-residency-us = <0x2703>;
				local-timer-stop;
				phandle = <0x08>;
			};
		};
	};

	firmware {

		scm {
			compatible = "qcom,scm-msm8998", "qcom,scm";
		};
	};

	memory@80000000 {
		device_type = "memory";
		reg = <0x00 0x80000000 0x00 0x80000000 0x01 0x00 0x00 0x7e4c0000>;
	};

	opp-table-dsi {
		compatible = "operating-points-v2";
		phandle = <0x59>;

		opp-131250000 {
			opp-hz = <0x00 0x7d2b750>;
			required-opps = <0x18>;
		};

		opp-210000000 {
			opp-hz = <0x00 0xc845880>;
			required-opps = <0x19>;
		};

		opp-262500000 {
			opp-hz = <0x00 0xfa56ea0>;
			required-opps = <0x1a>;
		};
	};

	pmu {
		compatible = "arm,armv8-pmuv3";
		interrupts = <0x01 0x06 0x04>;
	};

	psci {
		compatible = "arm,psci-1.0";
		method = "smc";
	};

	remoteproc {
		compatible = "qcom,sdm660-rpm-proc", "qcom,rpm-proc";

		glink-edge {
			compatible = "qcom,glink-rpm";
			interrupts = <0x00 0xa8 0x01>;
			qcom,rpm-msg-ram = <0x1b>;
			mboxes = <0x1c 0x00>;

			rpm-requests {
				compatible = "qcom,rpm-sdm660", "qcom,glink-smd-rpm";
				qcom,glink-channels = "rpm_requests";

				clock-controller {
					compatible = "qcom,rpmcc-sdm660", "qcom,rpmcc";
					#clock-cells = <0x01>;
					phandle = <0x28>;
				};

				power-controller {
					compatible = "qcom,sdm660-rpmpd";
					#power-domain-cells = <0x01>;
					operating-points-v2 = <0x1d>;
					phandle = <0x03>;

					opp-table {
						compatible = "operating-points-v2";
						phandle = <0x1d>;

						opp1 {
							opp-level = <0x10>;
						};

						opp2 {
							opp-level = <0x20>;
						};

						opp3 {
							opp-level = <0x30>;
						};

						opp4 {
							opp-level = <0x40>;
							phandle = <0x49>;
						};

						opp5 {
							opp-level = <0x80>;
							phandle = <0x18>;
						};

						opp6 {
							opp-level = <0xc0>;
							phandle = <0x19>;
						};

						opp7 {
							opp-level = <0x100>;
							phandle = <0x1a>;
						};

						opp8 {
							opp-level = <0x140>;
						};

						opp9 {
							opp-level = <0x180>;
							phandle = <0x58>;
						};
					};
				};

				regulators-0 {
					compatible = "qcom,rpm-pm660l-regulators";
					vdd_s1-supply = <0x1e>;
					vdd_s2-supply = <0x1e>;
					vdd_s3_s4-supply = <0x1e>;
					vdd_s5-supply = <0x1e>;
					vdd_s6-supply = <0x1e>;
					vdd_l1_l9_l10-supply = <0x1f>;
					vdd_l2-supply = <0x20>;
					vdd_l3_l5_l7_l8-supply = <0x20>;
					vdd_l4_l6-supply = <0x20>;
					vdd_bob-supply = <0x1e>;

					bob {
						regulator-min-microvolt = <0x325aa0>;
						regulator-max-microvolt = <0x36ee80>;
						regulator-enable-ramp-delay = <0x1f4>;
						regulator-ramp-delay = <0x00>;
						phandle = <0x20>;
					};

					s1 {
						regulator-min-microvolt = <0x112a88>;
						regulator-max-microvolt = <0x112a88>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-ramp-delay = <0x00>;
					};

					s2 {
						regulator-min-microvolt = <0x100590>;
						regulator-max-microvolt = <0x100590>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-ramp-delay = <0x00>;
						phandle = <0x1f>;
					};

					l1 {
						regulator-min-microvolt = "", "\f5";
						regulator-max-microvolt = <0xe1d48>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-allow-set-load;
						phandle = <0x3f>;
					};

					l2 {
						regulator-min-microvolt = <0x192580>;
						regulator-max-microvolt = <0x2f4d60>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-allow-set-load;
						phandle = <0x48>;
					};

					l3 {
						regulator-min-microvolt = <0x2dc6c0>;
						regulator-max-microvolt = <0x2dc6c0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-min-microamp = <0xc8>;
						regulator-max-microamp = <0x927c0>;
						regulator-system-load = <0x186a0>;
						regulator-allow-set-load;
						regulator-always-on;
					};

					l4 {
						regulator-min-microvolt = <0x19f0a0>;
						regulator-max-microvolt = <0x2d0b40>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-min-microamp = <0xc8>;
						regulator-max-microamp = <0x927c0>;
						regulator-system-load = <0x8b290>;
						regulator-allow-set-load;
						phandle = <0x4d>;
					};

					l5 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x32c800>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-allow-set-load;
						phandle = <0x47>;
					};

					l6 {
						regulator-min-microvolt = <0x1a0040>;
						regulator-max-microvolt = <0x328980>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
					};

					l7 {
						regulator-min-microvolt = <0x2932e0>;
						regulator-max-microvolt = <0x2faf08>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						phandle = <0x3c>;
					};

					l8 {
						regulator-min-microvolt = <0x30d400>;
						regulator-max-microvolt = <0x33e140>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
					};

					l9 {
						status = "disabled";
					};

					l10 {
						status = "disabled";
					};
				};

				regulators-1 {
					compatible = "qcom,rpm-pm660-regulators";
					vdd_s1-supply = <0x1e>;
					vdd_s2-supply = <0x1e>;
					vdd_s3-supply = <0x1e>;
					vdd_s4-supply = <0x1e>;
					vdd_s5-supply = <0x1e>;
					vdd_s6-supply = <0x1e>;
					vdd_l1_l6_l7-supply = <0x21>;
					vdd_l2_l3-supply = <0x1f>;
					vdd_l5-supply = <0x1f>;
					vdd_l8_l9_l10_l11_l12_l13_l14-supply = <0x22>;
					vdd_l15_l16_l17_l18_l19-supply = <0x20>;

					s1 {
						status = "disabled";
					};

					s2 {
						status = "disabled";
					};

					s3 {
						status = "disabled";
					};

					s4 {
						regulator-min-microvolt = <0x1b8ac8>;
						regulator-max-microvolt = <0x1f20c0>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-ramp-delay = <0x00>;
						regulator-always-on;
						phandle = <0x22>;
					};

					s5 {
						regulator-min-microvolt = <0x12ad40>;
						regulator-max-microvolt = <0x149970>;
						regulator-enable-ramp-delay = <0xc8>;
						regulator-ramp-delay = <0x00>;
						phandle = <0x21>;
					};

					s6 {
						regulator-min-microvolt = <0x7b0c0>;
						regulator-max-microvolt = <0xf2300>;
						regulator-enable-ramp-delay = <0x96>;
						regulator-ramp-delay = <0x00>;
					};

					l1 {
						regulator-min-microvolt = <0x118c30>;
						regulator-max-microvolt = <0x1312d0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-allow-set-load;
						phandle = <0x5a>;
					};

					l2 {
						regulator-min-microvolt = <0xe7ef0>;
						regulator-max-microvolt = <0xf6950>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
					};

					l3 {
						regulator-min-microvolt = <0xe7ef0>;
						regulator-max-microvolt = <0xf6950>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
					};

					l5 {
						regulator-min-microvolt = <0x802c8>;
						regulator-max-microvolt = <0xe86c0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						phandle = <0x91>;
					};

					l6 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x14dfc0>;
						regulator-allow-set-load;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						phandle = <0x76>;
					};

					l7 {
						regulator-min-microvolt = <0x124f80>;
						regulator-max-microvolt = <0x124f80>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
					};

					l8 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x1cfde0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-system-load = <0x4f588>;
						regulator-allow-set-load;
						phandle = <0x4e>;
					};

					l9 {
						regulator-min-microvolt = <0x1ab3f0>;
						regulator-max-microvolt = <0x1cfde0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-allow-set-load;
						phandle = <0x75>;
					};

					l10 {
						regulator-min-microvolt = <0x1b2920>;
						regulator-max-microvolt = <0x1dc130>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-allow-set-load;
						regulator-system-load = <0x36b0>;
						phandle = <0x40>;
					};

					l11 {
						regulator-min-microvolt = <0x1b38c0>;
						regulator-max-microvolt = <0x1da9c0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-always-on;
						phandle = <0x6d>;
					};

					l12 {
						regulator-min-microvolt = <0x1b7740>;
						regulator-max-microvolt = <0x1da9c0>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
					};

					l13 {
						regulator-min-microvolt = <0x1b2920>;
						regulator-max-microvolt = <0x1dc130>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-boot-on;
						regulator-always-on;
						phandle = <0x78>;
					};

					l14 {
						regulator-min-microvolt = <0x1a17b0>;
						regulator-max-microvolt = <0x1d0d80>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
					};

					l15 {
						regulator-min-microvolt = <0x192d50>;
						regulator-max-microvolt = <0x2d0b40>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
					};

					l16 {
						status = "disabled";
					};

					l17 {
						regulator-min-microvolt = <0x192580>;
						regulator-max-microvolt = <0x2d0b40>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
					};

					l18 {
						status = "disabled";
					};

					l19 {
						regulator-min-microvolt = <0x30d400>;
						regulator-max-microvolt = <0x33e140>;
						regulator-enable-ramp-delay = <0xfa>;
						regulator-ramp-delay = <0x00>;
						regulator-allow-set-load;
						phandle = <0x77>;
					};
				};
			};
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		wlan-msa-guard@85600000 {
			reg = <0x00 0x85600000 0x00 0x100000>;
			no-map;
		};

		wlan-msa-mem@85700000 {
			reg = <0x00 0x85700000 0x00 0x100000>;
			no-map;
			phandle = <0x90>;
		};

		qhee-code@85800000 {
			reg = <0x00 0x85800000 0x00 0x600000>;
			no-map;
		};

		memory@85e00000 {
			compatible = "qcom,rmtfs-mem";
			reg = <0x00 0x85e00000 0x00 0x200000>;
			no-map;
			qcom,client-id = <0x01>;
			qcom,vmid = <0x0f>;
		};

		smem-mem@86000000 {
			reg = <0x00 0x86000000 0x00 0x200000>;
			no-map;
			phandle = <0x23>;
		};

		memory@86200000 {
			reg = <0x00 0x86200000 0x00 0x3300000>;
			no-map;
		};

		mpss@8ac00000 {
			reg = <0x00 0x8ac00000 0x00 0x7e00000>;
			no-map;
			phandle = <0x2e>;
		};

		adsp@92a00000 {
			reg = <0x00 0x92a00000 0x00 0x1f00000>;
			no-map;
			phandle = <0x8d>;
		};

		adsp-region@f6000000 {
			reg = <0x00 0xf6000000 0x00 0x800000>;
			no-map;
		};

		qseecom-region@f6800000 {
			reg = <0x00 0xf6800000 0x00 0x1400000>;
			no-map;
		};

		mpss-metadata {
			alloc-ranges = <0x00 0xa0000000 0x00 0x20000000>;
			size = <0x00 0x4000>;
			no-map;
			phandle = <0x2f>;
		};

		mba@94900000 {
			reg = <0x00 0x94900000 0x00 0x200000>;
			no-map;
			phandle = <0x2d>;
		};

		cdsp@94b00000 {
			reg = <0x00 0x94b00000 0x00 0x600000>;
			no-map;
			phandle = <0x93>;
		};

		framebuffer_memory@9d400000 {
			reg = <0x00 0x9d400000 0x00 0x8ca000>;
			no-map;
		};

		venus@9cc00000 {
			reg = <0x00 0x9cc00000 0x00 0x800000>;
			no-map;
			phandle = <0x88>;
		};

		ramoops@9fe00000 {
			compatible = "ramoops";
			reg = <0x00 0x9fe00000 0x00 0x100000>;
			console-size = <0x80000>;
			record-size = <0x1000>;
			ftrace-size = <0x1000>;
			pmsg-size = <0x8000>;
		};

		gpu@f0b00000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xf0b00000 0x00 0x2000>;
			no-map;
			phandle = <0x35>;
		};
	};

	smem {
		compatible = "qcom,smem";
		memory-region = <0x23>;
		hwlocks = <0x24 0x03>;
	};

	smp2p-adsp {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1bb 0x1ad>;
		interrupts = <0x00 0x9e 0x01>;
		mboxes = <0x1c 0x0a>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x02>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x8e>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x8c>;
		};
	};

	smp2p-mpss {
		compatible = "qcom,smp2p";
		qcom,smem = <0x1b3 0x1ac>;
		interrupts = <0x00 0x1c3 0x01>;
		mboxes = <0x1c 0x0e>;
		qcom,local-pid = <0x00>;
		qcom,remote-pid = <0x01>;

		master-kernel {
			qcom,entry-name = "master-kernel";
			#qcom,smem-state-cells = <0x01>;
			phandle = <0x2b>;
		};

		slave-kernel {
			qcom,entry-name = "slave-kernel";
			interrupt-controller;
			#interrupt-cells = <0x02>;
			phandle = <0x2a>;
		};
	};

	soc@0 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		ranges = <0x00 0x00 0x00 0xffffffff>;
		compatible = "simple-bus";

		clock-controller@100000 {
			compatible = "qcom,gcc-sdm660";
			#clock-cells = <0x01>;
			#reset-cells = <0x01>;
			#power-domain-cells = <0x01>;
			reg = <0x100000 0x94000>;
			clock-names = "xo", "sleep_clk";
			clocks = <0x25 0x26>;
			phandle = <0x27>;
		};

		sram@778000 {
			compatible = "qcom,rpm-msg-ram";
			reg = <0x778000 0x7000>;
			phandle = <0x1b>;
		};

		qfprom@780000 {
			compatible = "qcom,sdm630-qfprom", "qcom,qfprom";
			reg = <0x780000 0x621c>;
			#address-cells = <0x01>;
			#size-cells = <0x01>;

			hstx-trim@240 {
				reg = <0x243 0x01>;
				bits = <0x01 0x03>;
				phandle = <0x3e>;
			};

			gpu-speed-bin@41a0 {
				reg = <0x41a2 0x02>;
				bits = <0x05 0x08>;
				phandle = <0x32>;
			};
		};

		rng@793000 {
			compatible = "qcom,prng-ee";
			reg = <0x793000 0x1000>;
			clocks = <0x27 0x47>;
			clock-names = "core";
		};

		interconnect@1008000 {
			compatible = "qcom,sdm660-bimc";
			reg = <0x1008000 0x78000>;
			#interconnect-cells = <0x01>;
			phandle = <0x33>;
		};

		restart@10ac000 {
			compatible = "qcom,pshold";
			reg = <0x10ac000 0x04>;
		};

		interconnect@1500000 {
			compatible = "qcom,sdm660-cnoc";
			reg = <0x1500000 0x10000>;
			#interconnect-cells = <0x01>;
			phandle = <0x43>;
		};

		interconnect@1626000 {
			compatible = "qcom,sdm660-snoc";
			reg = <0x1626000 0x7090>;
			#interconnect-cells = <0x01>;
			phandle = <0x83>;
		};

		iommu@16c0000 {
			compatible = "qcom,sdm630-smmu-v2", "qcom,smmu-v2";
			reg = <0x16c0000 0x40000>;
			#global-interrupts = <0x02>;
			#iommu-cells = <0x01>;
			interrupts = <0x00 0xe5 0x04 0x00 0xe7 0x04 0x00 0x175 0x04 0x00 0x176 0x08 0x00 0x177 0x08 0x00 0x178 0x08 0x00 0x179 0x08 0x00 0x17a 0x08 0x00 0x1ce 0x04 0x00 0x1cf 0x04 0x00 0x1d0 0x04 0x00 0x1d1 0x04 0x00 0x1d2 0x04 0x00 0x1d3 0x04 0x00 0x161 0x04 0x00 0x162 0x04 0x00 0x163 0x04 0x00 0x164 0x04 0x00 0x165 0x04 0x00 0x166 0x04 0x00 0x167 0x04 0x00 0x168 0x04 0x00 0x1ba 0x04 0x00 0x1bb 0x04 0x00 0x1bc 0x04 0x00 0x1bf 0x04 0x00 0x1d4 0x04 0x00 0x1d5 0x04 0x00 0x1d8 0x04 0x00 0x1d9 0x04 0x00 0x1da 0x04>;
			phandle = <0x84>;
		};

		interconnect@1704000 {
			compatible = "qcom,sdm660-a2noc";
			reg = <0x1704000 0xc100>;
			#interconnect-cells = <0x01>;
			clock-names = "ipa", "ufs_axi", "aggre2_ufs_axi", "aggre2_usb3_axi", "cfg_noc_usb2_axi";
			clocks = <0x28 0x44 0x27 0x50 0x27 0x14 0x27 0x15 0x27 0x30>;
			phandle = <0x41>;
		};

		interconnect@1745000 {
			compatible = "qcom,sdm660-mnoc";
			reg = <0x1745000 0xa010>;
			#interconnect-cells = <0x01>;
			clock-names = "iface";
			clocks = <0x02 0x00>;
			phandle = <0x53>;
		};

		thermal-sensor@10ae000 {
			compatible = "qcom,sdm630-tsens", "qcom,tsens-v2";
			reg = <0x10ae000 0x1000 0x10ad000 0x1000>;
			#qcom,sensors = <0x0e>;
			interrupts = <0x00 0xb8 0x04 0x00 0x1ae 0x04>;
			interrupt-names = "uplow", "critical";
			#thermal-sensor-cells = <0x01>;
			phandle = <0x9d>;
		};

		hwlock@1f40000 {
			compatible = "qcom,tcsr-mutex";
			reg = <0x1f40000 0x20000>;
			#hwlock-cells = <0x01>;
			phandle = <0x24>;
		};

		syscon@1f60000 {
			compatible = "qcom,sdm630-tcsr", "syscon";
			reg = <0x1f60000 0x20000>;
			phandle = <0x2c>;
		};

		pinctrl@3100000 {
			compatible = "qcom,sdm660-pinctrl";
			reg = <0x3100000 0x400000 0x3500000 0x400000 0x3900000 0x400000>;
			reg-names = "south", "center", "north";
			interrupts = <0x00 0xd0 0x04>;
			gpio-controller;
			gpio-ranges = <0x29 0x00 0x00 0x72>;
			#gpio-cells = <0x02>;
			interrupt-controller;
			#interrupt-cells = <0x02>;
			gpio-reserved-ranges = <0x00 0x04>;
			phandle = <0x29>;

			blsp1-uart1-default-state {
				pins = "gpio0", "gpio1", "gpio2", "gpio3";
				function = "blsp_uart1";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x64>;
			};

			blsp1-uart1-sleep-state {
				pins = "gpio0", "gpio1", "gpio2", "gpio3";
				function = "gpio";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x65>;
			};

			blsp1-uart2-default-state {
				pins = "gpio4", "gpio5";
				function = "blsp_uart2";
				drive-strength = <0x02>;
				bias-disable;
				phandle = <0x66>;
			};

			blsp2-uart1-active-state {
				phandle = <0x73>;

				tx-rts-pins {
					pins = "gpio16", "gpio19";
