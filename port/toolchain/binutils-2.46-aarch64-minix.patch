diff --git a/ld/emulparams/aarch64elf_minix.sh b/ld/emulparams/aarch64elf_minix.sh
new file mode 100644
index 00000000..886c30f9
--- /dev/null
+++ b/ld/emulparams/aarch64elf_minix.sh
@@ -0,0 +1,17 @@
+# AArch64 MINIX 3: the generic AArch64 ELF emulation, shaped for an operating
+# system rather than for a simulator. This is the AArch64 counterpart of
+# armelf_minix.sh in the MINIX tree.
+source_sh ${srcdir}/emulparams/aarch64elf.sh
+
+# aarch64elf.sh describes a bare-metal target: EMBEDDED drops the ELF header
+# from the first page and STACK_ADDR places a .stack section for the
+# simulator. An executable loaded by an operating system wants neither.
+unset EMBEDDED
+unset STACK_ADDR
+
+TEXT_START_ADDR=0x400000
+MAXPAGESIZE="CONSTANT (MAXPAGESIZE)"
+COMMONPAGESIZE="CONSTANT (COMMONPAGESIZE)"
+
+# Where MINIX installs its run-time linker, when there is dynamic linking.
+ELF_INTERPRETER_NAME=\"/usr/libexec/ld.elf_so\"
