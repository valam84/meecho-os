		iommu@cd00000 {
			compatible = "qcom,sdm630-smmu-v2", "qcom,smmu-v2";
			reg = <0xcd00000 0x40000>;
			clocks = <0x02 0x77 0x02 0x25 0x02 0x26>;
			clock-names = "iface-mm", "iface-smmu", "bus-smmu";
			#global-interrupts = <0x02>;
			#iommu-cells = <0x01>;
			interrupts = <0x00 0xe5 0x04 0x00 0xe7 0x04 0x00 0x107 0x04 0x00 0x10a 0x04 0x00 0x10b 0x04 0x00 0x10c 0x04 0x00 0xf4 0x04 0x00 0xf5 0x04 0x00 0xf7 0x04 0x00 0xf8 0x04 0x00 0xf9 0x04 0x00 0xfa 0x04 0x00 0xfb 0x04 0x00 0xfc 0x04 0x00 0xfd 0x04 0x00 0xfe 0x04 0x00 0xff 0x04 0x00 0x100 0x04 0x00 0x104 0x04 0x00 0x105 0x04 0x00 0x106 0x04 0x00 0x110 0x04 0x00 0x111 0x04 0x00 0x112 0x04 0x00 0x113 0x04 0x00 0x114 0x04>;
			status = "okay";
			phandle = <0x54>;
		};

		pinctrl@15070000 {
			compatible = "qcom,sdm660-lpass-lpi-pinctrl";
			reg = <0x15070000 0x20000>;
			gpio-controller;
			#gpio-cells = <0x02>;
			gpio-ranges = <0x89 0x00 0x00 0x20>;
			phandle = <0x89>;

			cdc-pdm-default-state {
				phandle = <0x96>;

				clk-pins {
					pins = "gpio18";
					function = "pdm_clk";
					drive-strength = <0x08>;
					output-high;
				};

				sync-pins {
					pins = "gpio19";
					function = "pdm_sync";
					drive-strength = <0x04>;
					output-high;
				};

				tx-pins {
					pins = "gpio20";
					function = "pdm_tx";
					drive-strength = <0x08>;
				};

				rx-pins {
					pins = "gpio21", "gpio23", "gpio25";
					function = "pdm_rx";
					drive-strength = <0x04>;
					output-high;
				};
			};

			cdc-comp-default-state {
				pins = "gpio22", "gpio24";
				function = "comp_rx";
				drive-strength = <0x08>;
			};

			cdc-dmic-default-state {
				phandle = <0x97>;

				dmic1-clk-pins {
					pins = "gpio26";
					function = "dmic1_clk";
					drive-strength = <0x08>;
					output-high;
				};

				dmic1-data-pins {
					pins = "gpio27";
					function = "dmic1_data";
					drive-strength = <0x08>;
					output-high;
				};

				dmic2-clk-pins {
					pins = "gpio28";
					function = "dmic2_clk";
					drive-strength = <0x08>;
					input-enable;
				};

				dmic2-data-pins {
					pins = "gpio29";
					function = "dmic2_data";
					drive-strength = <0x08>;
					input-enable;
				};
			};
		};

		audio-codec@152c0000 {
