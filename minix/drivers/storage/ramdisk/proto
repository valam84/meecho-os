boot
0 0
d--755 0 0
	bin d--755 0 0
#ifdef __i386__
		cdprobe ---755 0 0 cdprobe
#endif
		sysenv ---755 0 0 sysenv
#if RAMDISK_SMALL == 1
		fsck_mfs ---755 0 0 fsck_mfs
#endif
		mount ---755 0 0 mount
		umount ---755 0 0 umount
		grep ---755 0 0 grep
		sh ---755 0 0 sh
#ifdef __aarch64__
		cat ---755 0 0 cat
		ls ---755 0 0 ls
#endif
	$
	sbin d--755 0 0
		minix-service ---755 0 0 minix-service
#ifdef __aarch64__
		reboot ---755 0 0 reboot
		shutdown ---755 0 0 shutdown
/* reboot decides what to do from the name it was called by, the way the
 * installed system links it three ways.
 */
		halt s--755 0 0 /sbin/reboot
		poweroff s--755 0 0 /sbin/reboot
#endif
	$
	service d--755 0 0
#ifdef __i386__
		floppy ---755 0 0 floppy
		ahci ---755 0 0 ahci
		virtio_blk ---755 0 0 virtio_blk
		at_wini ---755 0 0 at_wini
		pckbd ---755 0 0 pckbd
		pci ---755 0 0 pci
		isofs ---755 0 0 isofs
#if RAMDISK_INC_ACPI == 1
		acpi ---755 0 0 acpi
#endif
#if RAMDISK_SMALL == 1
		ext2 ---755 0 0 ext2
#endif
#endif
#ifdef __arm__
		mmc ---755 0 0 mmc
#endif
#ifdef __aarch64__
		virtio_blk ---755 0 0 virtio_blk
#endif
		mfs ---755 0 0 mfs
		procfs ---755 0 0 procfs
		input ---755 0 0 input
	$
	usr d--755 0 0
		bin d--755 0 0
			loadramdisk ---755 0 0 loadramdisk
#ifdef __aarch64__
			login ---755 0 0 login
#endif
		$
#ifdef __aarch64__
		libexec d--755 0 0
			getty ---755 0 0 getty
		$
#endif
	$
	proc d--755 0 0
	$
#ifdef __aarch64__
/* The image is the root here, so it needs the places a running system
 * writes to: a home for root, /var/run for utmpx, /var/log for wtmpx and
 * lastlogx, and a /tmp. Without the directories libc cannot create the
 * files, and init and login complain once per boot and once per login.
 */
	root d--700 0 0
	$
	tmp d--777 0 0
	$
	var d--755 0 0
		run d--755 0 0
		$
		log d--755 0 0
		$
	$
#endif
	dev d--755 0 0
#include "proto.dev"
	$
#include "proto.common.etc"
#if RAMDISK_DYNAMIC == 1
#include "proto.common.dynamic"
#endif
