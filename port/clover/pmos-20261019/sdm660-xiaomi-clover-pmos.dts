		video-codec@cc00000 {
			compatible = "qcom,sdm660-venus";
			reg = <0xcc00000 0xff000>;
			clocks = <0x02 0x81 0x02 0x7f 0x02 0x80 0x02 0x7e>;
			clock-names = "core", "iface", "bus", "bus_throttle";
			interconnects = <0x42 0x00 0x53 0x0d 0x53 0x04 0x33 0x05>;
			interconnect-names = "cpu-cfg", "video-mem";
			interrupts = <0x00 0x11f 0x04>;
			iommus = <0x54 0x400 0x54 0x401 0x54 0x40a 0x54 0x407 0x54 0x40e 0x54 0x40f 0x54 0x408 0x54 0x409 0x54 0x40b 0x54 0x40c 0x54 0x40d 0x54 0x410 0x54 0x421 0x54 0x428 0x54 0x429 0x54 0x42b 0x54 0x42c 0x54 0x42d 0x54 0x411 0x54 0x431>;
			memory-region = <0x88>;
			power-domains = <0x02 0x00>;
			status = "okay";
