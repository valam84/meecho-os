		remoteproc@4080000 {
			compatible = "qcom,sdm660-mss-pil";
			reg = <0x4080000 0x100 0x4180000 0x40>;
			reg-names = "qdsp6", "rmb";
			interrupts-extended = <0x01 0x00 0x1c0 0x01 0x2a 0x00 0x01 0x2a 0x01 0x01 0x2a 0x02 0x01 0x2a 0x03 0x01 0x2a 0x07 0x01>;
