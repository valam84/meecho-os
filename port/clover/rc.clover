#!/bin/sh
# /etc/rc of the Mi Pad 4's root on eMMC (the userdata partition, through
# the gptpart0=userdata window).  The ramdisk has started sdmmc, checked
# this volume and mounted it over the root; init runs this script, and the
# sessions of /etc/ttys after it.
#
# Not the CB2's rc (port/mkroot.sh): this machine has no Ethernet, its
# one USB port is the network or a host by turns, its GPU is an Adreno, not
# a Mali, and on a
# Snapdragon a driver that probes a block whose clock nobody turned on can
# stall the bus - so nothing is started here that was not written for this
# SoC or does not touch hardware at all.
PATH=/sbin:/usr/sbin:/bin:/usr/bin
export PATH

# Nobody else sets it, and services started from here would make files
# writable by everyone.
umask 022

# The CPU clusters at the rates their rails already hold, first, so that
# everything after runs on them (port/clover/hw-cpu.md, path A, steps 3-5):
# gold 1747.2 MHz instead of the boot loader's 600, silver 1536 instead of
# 1382.4 - no write to the PMIC, only the clusters' mux and PLL.  The
# service reads the rails back before each change and refuses a point
# they do not hold, so a tablet whose fuses ask for more keeps the boot
# loader's rates.  It stays and moves each cluster by its load, between
# aux (600 MHz, the PLL off) and those tops: cpugov= (a boot argument) is
# ondemand by default, performance - the tops always, as before - or
# powersave - 600 MHz always.  cpufreq=0 leaves the clusters as the boot
# loader set them.
if [ -x /service/qcom_cpufreq ] && [ "`sysenv cpufreq 2>/dev/null`" != 0 ]
then
	cpugov=ondemand
	if sysenv cpugov >/dev/null
	then	cpugov="`sysenv cpugov`"
	fi
	minix-service up /service/qcom_cpufreq \
	    -args "stage=gov gov=$cpugov gold=1747 silver=1536 report=60" \
	    2>/dev/null
fi

echo "Root is on `sysenv rootdevname` (`sysenv gptpart0`), driver `sysenv blkdrv`."

# The screen: the frame the boot loader left running (simple-framebuffer).
# card=0: no test card.  osk= and fontscale= come from the boot arguments.
if [ -x /service/fb ]
then
	minix-service up /service/fb -dev /dev/fb0 -args card=0 ||
	    echo "WARNING: no display"
fi

# Input: the input server, the PMIC's buttons (volume keys as the arrows,
# power for the backlight; battery and charger in the log) and the touch
# screen as the keys of the keyboard fb draws with osk=1.
minix-service up /service/input -dev /dev/kbdmux ||
    echo "WARNING: no input server"
if [ -x /service/qcom_pmic ]
then
	minix-service up /service/qcom_pmic || echo "WARNING: no PMIC driver"
fi
# The regulators the tree keeps on, from the RPM - without them the touch
# screen has no analogue supply (3.0 V, L3B).
if [ -x /service/qcom_rpm ]
then
	minix-service up /service/qcom_rpm || echo "WARNING: no RPM regulators"
fi
if [ -x /service/qcom_touch ]
then
	minix-service up /service/qcom_touch ||
	    echo "WARNING: no touch screen driver"
fi

# The firmware, from this tablet's own partitions, once: the remote
# processors' and the GPU's files are Qualcomm's and Xiaomi's, not
# MEECHO's to ship, and the tablet carries them - the modem, Wi-Fi and DSP
# images on "modem" (FAT, image/), the GPU's microcode and zap shader on
# "vendor" (ext4, /firmware).  The read-only windows gptro0= names are
# /dev/c0d0p3..p0 and then /dev/c0d0p3s3..p3s0 in the order named
# (sdmmc.c); /dev/gptro/NAME links them by name.  fwimport (minix/usr.sbin/
# fwimport) copies into a fresh directory and only a whole copy is moved
# into place, so a copy cut short is taken again at the next boot.
# fwimport=0 (a boot argument) leaves /libdata/firmware as it is.
mkdir -p /dev/gptro
cmaj=`ls -l /dev/c0d0 2>/dev/null | awk '{ sub(",", "", $5); print $5 }'`
i=0
for p in `sysenv gptro0 2>/dev/null | tr , ' '`
do
	if [ $i -lt 4 ]
	then	d=/dev/c0d0p$((3 - i)); m=$((4 - i))
	else	d=/dev/c0d0p3s$((7 - i)); m=$((128 + 15 - (i - 4)))
	fi
	[ -b $d ] || [ -z "$cmaj" ] || mknod $d b $cmaj $m
	ln -sf $d /dev/gptro/$p
	i=$((i + 1))
done
fw=/libdata/firmware/qcom
if [ "`sysenv fwimport 2>/dev/null`" != 0 ] && [ -x /usr/sbin/fwimport ]
then
	if [ ! -f $fw/clover/modem/mba.mbn ] && [ -b /dev/gptro/modem ]
	then
		echo "Copying the modem's firmware off the modem partition"
		rm -rf $fw/clover/modem.new && mkdir -p $fw/clover &&
		    fwimport fat /dev/gptro/modem image $fw/clover/modem.new &&
		    [ -f $fw/clover/modem.new/mba.mbn ] &&
		    mv $fw/clover/modem.new $fw/clover/modem ||
		    echo "WARNING: no modem firmware copied"
	fi
	if [ ! -f $fw/a530_pm4.fw ] && [ -b /dev/gptro/vendor ]
	then
		echo "Copying the GPU's firmware off the vendor partition"
		rm -rf $fw.new && fwimport ext4 /dev/gptro/vendor $fw.new \
		    /firmware/a530_pm4.fw /firmware/a530_pfp.fw \
		    /firmware/a512_zap.mdt /firmware/a512_zap.b00 \
		    /firmware/a512_zap.b01 /firmware/a512_zap.b02 &&
		    mkdir -p $fw && mv $fw.new/* $fw/ && rmdir $fw.new ||
		    echo "WARNING: no GPU firmware copied"
	fi
	sync
fi

# The GPU: Adreno 512, Mesa's freedreno through /dev/dri/renderD128
# (port/clover/hw-gpu.md).  After qcom_rpm, which takes its VDDMX votes.
# It needs the CP's microcode and the tablet's zap shader in
# /libdata/firmware/qcom - neither may be in MEECHO's tree, so a kit puts
# them there (port/clover/mkkit.sh) or they are copied in by hand; without
# them the service is not started and the desktop draws with the
# processor.  gpufreq= (a boot argument): the core's highest clock, "max"
# by default - the highest point the chip's speed bin allows, 588 MHz on
# this tablet - or MHz, or 0 for the crystal.  gpugov=: ondemand (the
# default) moves it between 160 MHz and that by load, performance keeps
# it there, powersave at 160.  gpusleep=MS powers the GPU off after that
# long without a job (0: never).
if [ -x /service/adreno ] && [ -f /libdata/firmware/qcom/a530_pm4.fw ]
then
	gpufreq=max
	if sysenv gpufreq >/dev/null
	then	gpufreq="`sysenv gpufreq`"
	fi
	gpugov=ondemand
	if sysenv gpugov >/dev/null
	then	gpugov="`sysenv gpugov`"
	fi
	gpusleep=0
	if sysenv gpusleep >/dev/null
	then	gpusleep="`sysenv gpusleep`"
	fi
	[ -c /dev/dri/renderD128 ] || { mkdir -p /dev/dri &&
	    mknod /dev/dri/renderD128 c 18 128 &&
	    chmod 666 /dev/dri/renderD128; }
	minix-service up /service/adreno -dev /dev/dri/renderD128 \
	    -args "freq=$gpufreq gov=$gpugov sleep=$gpusleep report=60" ||
	    echo "WARNING: no GPU"
fi

# Randomness: the SoC's PRNG (qcom,prng-ee, random/qcom_prng.c) seeds the
# pool; sshd's host key below is made from it.
minix-service up /service/random -dev /dev/random ||
    echo "WARNING: no random device"

# Local sockets (AF_UNIX): socketpair(2) fails without them.
minix-service up /service/uds || echo "WARNING: no local sockets"

# Pseudo terminals, both kinds (see the CB2's rc for the reasons).
if [ -x /service/pty ]
then
	minix-service up /service/pty -dev /dev/ptyp0 \
	    -args "gid=$(stat -f %g /dev/ptmx)" ||
	    echo "WARNING: no pseudo terminals"
fi
if [ -x /service/ptyfs ]
then
	mount -t ptyfs -o rslabel=ptyfs none /dev/pts >/dev/null ||
	    echo "WARNING: no Unix98 pseudo terminals"
fi

if [ -x /usr/sbin/dev_mkdb ] &&
   { [ ! -f /var/run/dev.cdb ] || [ /dev -nt /var/run/dev.cdb ]; }
then
	/usr/sbin/dev_mkdb || echo "WARNING: dev_mkdb failed"
fi

# The USB-C port, and with it the network.  The port is one: a device to
# the hub on the cable - a CDC Ethernet adapter, dwc3_ecm (hw-net.md);
# netdrv= names another - or a host to what an OTG adapter carries, a
# keyboard and a mouse (xhci, usb_hub, usb_kbd, usb_mouse; hw-usbhost.md).
# usbrole(8) decides from Type-C, which qcom_pmic reads: the hub's cable
# is a source, so a device, as it always was; an adapter is a sink, so a
# host, powered from the PMIC's boost.  It brings the role up once here and
# then follows the port in the background, its lines on the screen.  The
# drivers take the port over only as the boot loader left it running -
# after "fastboot boot" - and otherwise say so and leave.  usbrole=device
# (a boot argument) keeps the port a device and starts nothing to follow it.
# No DHCP: the other end is a hub with a fixed address, and this end is
# netaddr= or 10.42.0.2/24.  lwip and sshd come up whatever the role: a
# port that becomes a device later brings its interface to them.
minix-service up /service/lwip -dev /dev/bpf ||
    echo "WARNING: no network stack"
ifconfig lo0 inet 127.0.0.1 up 2>/dev/null
if [ -x /usr/sbin/usbrole ]
then
	/usr/sbin/usbrole -1
else
	# A root from before usbrole: the port is a device, as then.
	netdrv=dwc3_ecm
	if sysenv netdrv >/dev/null
	then	netdrv="`sysenv netdrv`"
	fi
	netaddr=10.42.0.2/24
	if sysenv netaddr >/dev/null
	then	netaddr="`sysenv netaddr`"
	fi
	netlog=2
	if sysenv netlog >/dev/null
	then	netlog="`sysenv netlog`"
	fi
	netif=
	if [ -x "/service/$netdrv" ] &&
	   minix-service up "/service/$netdrv" -label "${netdrv}_0" \
	    -args "instance=0 log=$netlog"
	then
		for t in 1 2 3 4 5
		do
			for i in `ifconfig -l 2>/dev/null`
			do
				[ "$i" != lo0 ] && netif=$i
			done
			[ -n "$netif" ] && break
			sleep 1
		done
		if [ -n "$netif" ]
		then
			ifconfig "$netif" inet "$netaddr" up ||
			    echo "WARNING: $netif has no address"
		else
			echo "WARNING: no interface from $netdrv"
		fi
	else
		echo "No network: no $netdrv, or it found nothing to drive"
	fi
fi
for i in `ifconfig -l 2>/dev/null`
do
	[ "$i" != lo0 ] && ifconfig "$i" | grep 'inet '
done

# ssh, as on the CB2 (port/mkroot.sh): the host key made here, on the
# first boot, never put in the image; whether the pool is seeded asked
# outright, because arc4random(3) would make a weak key without a word.
if ! dd if=/dev/random bs=1 count=1 >/dev/null 2>&1
then
	echo "WARNING: /dev/random is not seeded; keys made now are weak"
fi
if [ -x /usr/bin/ssh-keygen ] &&
   [ ! -f /etc/ssh/ssh_host_ed25519_key ]
then
	echo "Generating an SSH host key"
	/usr/bin/ssh-keygen -q -t ed25519 -N '' \
	    -f /etc/ssh/ssh_host_ed25519_key ||
	    echo "WARNING: could not generate a host key"
fi
if [ -x /usr/sbin/sshd ] && [ -f /etc/ssh/ssh_host_ed25519_key ]
then
	echo "Starting sshd"
	/usr/sbin/sshd || echo "WARNING: sshd did not start"
fi

# The modem (port/clover/hw-modem.md), with modem=1 (a boot argument) and
# its firmware in /libdata/firmware/qcom/clover/modem - a copy of the modem
# partition's image/, not MEECHO's to carry.  After ssh, so that a modem
# that does not come up leaves the tablet reachable.  In order: the memory
# rmtfs shares with the modem (given to its VM), the router
# (qrtr: GLINK once the modem is up, AF_QIPCRTR sockets), the daemons the
# modem asks for - rmtfs with its storage read only (the partitions
# gptro0= names, modemst1,modemst2,fsg,fsc, are /dev/c0d0p3..p0, linked by
# name under /dev/modem), tqftpserv, diag-router, pd-mapper - and the
# modem itself last.  modemstage= passes stage= to qcom_mss (probe: read
# only; mba: the MBA and no more).  One start per boot: stopping and
# starting the modem again is not safe yet (hw-modem.md, section 8).
if [ "`sysenv modem 2>/dev/null`" = 1 ] && [ -x /service/qcom_mss ] &&
   [ -f /libdata/firmware/qcom/clover/modem/mba.mbn ]
then
	mkdir -p /dev/modem
	i=4
	for p in `sysenv gptro0 2>/dev/null | tr , ' '`
	do
		[ $i -ge 1 ] || break
		ln -sf /dev/c0d0p$((i - 1)) /dev/modem/$p
		i=$((i - 1))
	done
	[ -c /dev/qcom_rmtfs_mem1 ] ||
	    mknod /dev/qcom_rmtfs_mem1 c 135 1
	minix-service up /service/qcom_rmtfs_mem -dev /dev/qcom_rmtfs_mem1 ||
	    echo "WARNING: no rmtfs shared memory"
	minix-service up /service/qrtr || echo "WARNING: no QRTR"
	if [ -x /usr/sbin/rmtfs ]
	then
		( trap '' HUP; /usr/sbin/rmtfs -r -P -o /dev/modem -v ) \
		    </dev/null >/var/log/rmtfs.log 2>&1 &
	fi
	if [ -x /usr/sbin/tqftpserv ]
	then
		( trap '' HUP; /usr/sbin/tqftpserv ) \
		    </dev/null >/var/log/tqftpserv.log 2>&1 &
	fi
	# The taker of the modem's diagnostic stream (QRTR service 4097);
	# without it the modem stops after minutes with "Task starvation:
	# diag" (hw-modem.md, §8).  Before the modem, as postmarketOS has it.
	if [ -x /usr/sbin/diag-router ]
	then
		( trap '' HUP; /usr/sbin/diag-router ) \
		    </dev/null >/var/log/diag-router.log 2>&1 &
	fi
	# The service locator the modem asks for its protection domains;
	# without it the modem stops within a minute (hw-modem.md, §8).
	if [ -x /usr/sbin/pd-mapper ]
	then
		( trap '' HUP; /usr/sbin/pd-mapper ) \
		    </dev/null >/var/log/pd-mapper.log 2>&1 &
	fi
	# The IPA, the modem's data path, with ipa=1 (hw-modem.md, section
	# 9): reset and laid out before the modem starts, as Linux has it;
	# ipaqmid then tells the modem's IPA driver where things are once it
	# is up.  ipastage= passes stage= (probe: read only).
	if [ "`sysenv ipa 2>/dev/null`" = 1 ] && [ -x /service/qcom_ipa ]
	then
		ipastage=init
		if sysenv ipastage >/dev/null
		then	ipastage="`sysenv ipastage`"
		fi
		[ -c /dev/ipa ] || mknod /dev/ipa c 137 0
		if minix-service up /service/qcom_ipa -dev /dev/ipa \
		    -args "stage=$ipastage" && [ "$ipastage" = init ] &&
		    [ -x /usr/sbin/ipaqmid ]
		then
			( trap '' HUP; /usr/sbin/ipaqmid ) \
			    </dev/null >/var/log/ipaqmid.log 2>&1 &
		fi
	fi
	# The modem last, once everything it asks for is there; it boots in
	# the background, and qrtr lays out GLINK when it is up.
	modemstage=boot
	if sysenv modemstage >/dev/null
	then	modemstage="`sysenv modemstage`"
	fi
	minix-service up /service/qcom_mss -args "stage=$modemstage" ||
	    echo "WARNING: qcom_mss did not start"
fi

# And the port from now on: a cable swapped for an adapter, and back.
if [ -x /usr/sbin/usbrole ]
then
	( trap '' HUP; /usr/sbin/usbrole -d ) </dev/null >/dev/console 2>&1 &
fi

# The desktop, with desktop=1 (a boot argument): meecho-desktop as root,
# in the background, as if typed at the console - meechowm takes the
# screen, the console keyboard gives way to the desktop's (meechowm-osk),
# touches go to the desktop, and a USB keyboard and mouse to it as soon as
# usbrole makes the port a host.  Super+Shift+e ends it, and the console
# has the screen back with login: on it.  Its log is /var/log/desktop.log.
if [ "`sysenv desktop 2>/dev/null`" = 1 ] && [ -x /usr/bin/meecho-desktop ]
then
	echo "Starting the desktop"
	( trap '' HUP; cd /root && HOME=/root USER=root LOGNAME=root \
	    SHELL=/bin/sh exec /usr/bin/meecho-desktop ) \
	    </dev/null >/var/log/desktop.log 2>&1 &
fi

exit 0
