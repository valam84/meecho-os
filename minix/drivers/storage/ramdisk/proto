boot
0 0
d--755 0 0
	bin d--755 0 0
#ifdef __i386__
		cdprobe ---755 0 0 cdprobe
#endif
		sysenv ---755 0 0 sysenv
#if RAMDISK_SMALL == 1
		fsck_mfs ---755 0 0 fsck_mfs
#endif
		mount ---755 0 0 mount
		umount ---755 0 0 umount
		grep ---755 0 0 grep
		sh ---755 0 0 sh
#ifdef __aarch64__
		cat ---755 0 0 cat
		ls ---755 0 0 ls
		readclock ---755 0 0 readclock
		date ---755 0 0 date
		mkdir ---755 0 0 mkdir
		rm ---755 0 0 rm
		rmdir ---755 0 0 rmdir
		ln ---755 0 0 ln
		mv ---755 0 0 mv
		cp ---755 0 0 cp
		sync ---755 0 0 sync
/* Raw sectors first, a filesystem second: dd is how a block driver nobody
 * has run before gets tried, and df is how the result is looked at.
 */
		dd ---755 0 0 dd
		df ---755 0 0 df
#endif
	$
	sbin d--755 0 0
		minix-service ---755 0 0 minix-service
#ifdef __aarch64__
		reboot ---755 0 0 reboot
		shutdown ---755 0 0 shutdown
/* This image is the whole system until there is a root to switch to, so it
 * is also the thing that has to create that root.  The program is
 * mkfs.mfsv3 and mkfs.mfs is the name it answers to, exactly as on an
 * installed system.
 */
		mkfs.mfsv3 ---755 0 0 mkfs.mfsv3
		mkfs.mfs s--755 0 0 /sbin/mkfs.mfsv3
		diskctl ---755 0 0 diskctl
/* reboot decides what to do from the name it was called by, the way the
 * installed system links it three ways.
 */
		halt s--755 0 0 /sbin/reboot
		poweroff s--755 0 0 /sbin/reboot
#endif
	$
	service d--755 0 0
#ifdef __i386__
		floppy ---755 0 0 floppy
		ahci ---755 0 0 ahci
		virtio_blk ---755 0 0 virtio_blk
		at_wini ---755 0 0 at_wini
		pckbd ---755 0 0 pckbd
		pci ---755 0 0 pci
		isofs ---755 0 0 isofs
#if RAMDISK_INC_ACPI == 1
		acpi ---755 0 0 acpi
#endif
#if RAMDISK_SMALL == 1
		ext2 ---755 0 0 ext2
#endif
#endif
#ifdef __arm__
		mmc ---755 0 0 mmc
#endif
#ifdef __aarch64__
		virtio_blk ---755 0 0 virtio_blk
		sdmmc ---755 0 0 sdmmc
		readclock.drv ---755 0 0 readclock.drv
#endif
		mfs ---755 0 0 mfs
		procfs ---755 0 0 procfs
		input ---755 0 0 input
	$
	usr d--755 0 0
		bin d--755 0 0
			loadramdisk ---755 0 0 loadramdisk
#ifdef __aarch64__
			login ---755 0 0 login
#endif
		$
#ifdef __aarch64__
		libexec d--755 0 0
			getty ---755 0 0 getty
		$
#endif
	$
	proc d--755 0 0
	$
#ifdef __aarch64__
/* The image is the root here, so it needs the places a running system
 * writes to: a home for root, /var/run for utmpx, /var/log for wtmpx and
 * lastlogx, and a /tmp. Without the directories libc cannot create the
 * files, and init and login complain once per boot and once per login.
 *
 * And a /mnt, because this image is also the thing that makes the root it
 * will hand over to: a file system it cannot mount is one it cannot fill,
 * and "mount: No such file or directory" names the mount point, not the
 * device, which is a confusing way to learn that a directory is missing.
 */
	root d--700 0 0
	$
	tmp d--777 0 0
	$
	mnt d--755 0 0
	$
	var d--755 0 0
		run d--755 0 0
		$
		log d--755 0 0
		$
/* dhcpcd keeps the lease and its monotonic counter here. Without the
 * directory it asks for an address, gets one, and cannot remember it, so
 * every boot looks like a new machine to the server.
 */
		db d--755 0 0
		$
/* sshd separates the protocol from the privileges: the part that talks
 * to the network runs as the "sshd" pseudo-user chrooted here. The
 * directory has to exist, be owned by root and be empty, or sshd says
 * so and refuses to start.
 */
		chroot d--755 0 0
			sshd d--755 0 0
			$
		$
/* vi keeps recovery files here and complains on every start when the
 * directory is missing -- which is the first thing a new root notices.
 */
		tmp d--777 0 0
			vi.recover d--777 0 0
			$
		$
	$
#endif
	dev d--755 0 0
#include "proto.dev"
	$
#include "proto.common.etc"
#if RAMDISK_DYNAMIC == 1
#include "proto.common.dynamic"
#endif
$
